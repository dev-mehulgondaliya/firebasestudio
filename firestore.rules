rules_version = '2';

// Security rules for Firebase Studio's OWN Firestore project (the one set via
// STUDIO_FIREBASE_SERVICE_ACCOUNT), not for projects users connect to.
//
// Studio reads and writes its data only from the Next.js server with the Admin
// SDK, which enforces per-user ownership (userId) in code. Browsers never talk
// to this database directly, so all client access is denied. In particular,
// `connections` holds encrypted service-account keys and must never be exposed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
