# Firebase Studio configuration. Copy to .env.local and fill in.

# --- Authentication (required) ---------------------------------------------
# Password for the Studio owner account (single-operator mode).
STUDIO_PASSWORD=change-me
# Secret used to sign session cookies. At least 32 random characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
STUDIO_SESSION_SECRET=
# Optional display email / identifier for the owner account.
STUDIO_OWNER_EMAIL=owner@localhost

# --- Credential encryption (required) ---------------------------------------
# 32-byte key, base64 encoded. Used to encrypt service-account JSON at rest.
# In production, load this from a secret manager (e.g. Google Secret Manager).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STUDIO_ENCRYPTION_KEY=

# --- Studio's own database (optional) ----------------------------------------
# By default Studio stores its data (connections, scripts, history) in
# ./.studio-data/db.json. To use a separate Firestore project instead, provide
# a service account for THAT project (raw JSON or base64-encoded JSON).
# This must NOT be one of the projects you connect to inside Studio.
STUDIO_FIREBASE_SERVICE_ACCOUNT=

# --- Server-side execution ----------------------------------------------------
# Set to "disabled" to turn off Admin SDK (Node.js) script execution entirely.
STUDIO_SERVER_EXECUTION=enabled
# Comma-separated environment variable names that scripts may read via process.env.
# Nothing else from the server environment is passed to the execution worker.
EXECUTION_ENV_ALLOWLIST=
# Maximum concurrent Node.js execution workers.
EXECUTION_MAX_CONCURRENCY=3
